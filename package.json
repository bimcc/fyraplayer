{
  "name": "@bimccfyra/fyraplayer",
  "version": "1.1.0",
  "description": "Extensible web playback SDK with optional UI, monitoring, panorama and WebTransport plugins.",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./plugins/playback-health": {
      "types": "./dist/plugins/playback-health.d.ts",
      "import": "./dist/plugins/playback-health.js"
    },
    "./plugins/gb-gateway": {
      "types": "./dist/plugins/gb-gateway.d.ts",
      "import": "./dist/plugins/gb-gateway.js"
    },
    "./plugins/webtransport": {
      "types": "./dist/plugins/webtransport.d.ts",
      "import": "./dist/plugins/webtransport.js"
    },
    "./plugins/snapshot": {
      "types": "./dist/plugins/snapshot.d.ts",
      "import": "./dist/plugins/snapshot.js"
    },
    "./plugins/frame-clock": {
      "types": "./dist/plugins/frame-clock.d.ts",
      "import": "./dist/plugins/frame-clock.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./plugins/engines": {
      "types": "./dist/plugins/engines/index.d.ts",
      "import": "./dist/plugins/engines/index.js"
    },
    "./plugins/metadata": {
      "types": "./dist/plugins/metadata/index.d.ts",
      "import": "./dist/plugins/metadata/index.js"
    },
    "./plugins/ui-components": {
      "types": "./dist/plugins/ui-components.d.ts",
      "import": "./dist/plugins/ui-components.js"
    },
    "./plugins/metrics": {
      "types": "./dist/plugins/metrics.d.ts",
      "import": "./dist/plugins/metrics.js"
    },
    "./plugins/performance": {
      "types": "./dist/plugins/performance.d.ts",
      "import": "./dist/plugins/performance.js"
    },
    "./plugins/panoramalite": {
      "types": "./dist/plugins/panoramalite.d.ts",
      "import": "./dist/plugins/panoramalite.js"
    },
    "./plugins/reconnect": {
      "types": "./dist/plugins/reconnect.d.ts",
      "import": "./dist/plugins/reconnect.js"
    },
    "./plugins/recording-api": {
      "types": "./dist/plugins/recording.d.ts",
      "import": "./dist/plugins/recording.js"
    },
    "./plugins/diagnostics": {
      "types": "./dist/plugins/diagnostics.d.ts",
      "import": "./dist/plugins/diagnostics.js"
    },
    "./plugins/auth": {
      "types": "./dist/plugins/auth.d.ts",
      "import": "./dist/plugins/auth.js"
    },
    "./plugins/dash": {
      "types": "./dist/plugins/dash.d.ts",
      "import": "./dist/plugins/dash.js"
    },
    "./vendor/dash.all.min.js": "./dist/vendor/dash.all.min.js",
    "./plugins/storage": {
      "types": "./dist/plugins/storage.d.ts",
      "import": "./dist/plugins/storage.js"
    },
    "./techs/wsRaw/demuxer": {
      "types": "./dist/techs/wsRaw/demuxer.d.ts",
      "import": "./dist/techs/wsRaw/demuxer.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json && node checks/copy-vendor.mjs",
    "build:release": "pnpm build && pnpm bundle:iife",
    "check:public-api": "tsc -p tsconfig.public-api.json",
    "check:exports": "pnpm build && node checks/export-contract.mjs",
    "check:release": "pnpm check:metadata && pnpm test:coverage --runInBand && pnpm check:unused && pnpm check:public-api && pnpm check:sources && pnpm check:docs && pnpm check:plugins && pnpm build:release && node checks/export-contract.mjs && pnpm check:package && pnpm bundle:examples",
    "check:plugins": "node checks/plugin-boundaries.mjs",
    "check:sources": "node checks/sources-contract.mjs",
    "serve:fmp4-fixture": "node checks/ffmpeg-fmp4-fixture.mjs",
    "long-run:browser": "node checks/browser-long-run.mjs",
    "long-run:assert": "node checks/browser-long-run-assert.mjs",
    "smoke:panoramalite": "node checks/panoramalite-smoke.mjs",
    "bundle:examples": "vite build --config vite.config.ts",
    "bundle:iife": "esbuild src/iife.ts --bundle --outfile=dist/fyraplayer.iife.js --platform=browser --format=iife --global-name=FyraPlayerSDK",
    "bundle:examples:watch": "vite build --config vite.config.ts --watch",
    "dev": "vite --config vite.config.ts",
    "serve:examples": "vite --config vite.config.ts",
    "dev:vite": "vite --config vite.config.ts",
    "dev:vite:host": "vite --config vite.config.ts --host --port 3000",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "preview:examples": "vite preview --config vite.config.ts",
    "check:unused": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "check:docs": "node checks/docs-contract.mjs",
    "check:package": "node checks/package-consumer.mjs",
    "check:metadata": "node checks/release-contract.mjs",
    "release:candidate": "node checks/release-candidate.mjs",
    "prepublishOnly": "pnpm check:release"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  },
  "peerDependencies": {
    "dashjs": "^5.1.1",
    "mpegts.js": "^1.8.0",
    "mp4box": "^0.5.4"
  },
  "peerDependenciesMeta": {
    "dashjs": {
      "optional": true
    },
    "mpegts.js": {
      "optional": true
    },
    "mp4box": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.41",
    "dashjs": "^5.1.1",
    "esbuild": "^0.28.0",
    "jest": "^30.4.2",
    "mp4box": "^0.5.4",
    "ts-jest": "^29.4.10",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bimcc/fyraplayer.git"
  },
  "homepage": "https://github.com/bimcc/fyraplayer#readme",
  "bugs": {
    "url": "https://github.com/bimcc/fyraplayer/issues"
  }
}
